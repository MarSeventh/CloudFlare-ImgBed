{
  "name": "cloudflare-imgbed",
  "version": "2.7.8",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build:info": "node scripts/build-info.mjs --write-manifest",
    "ci-test": "concurrently --kill-others \"pnpm start\" \"wait-on http://localhost:8080 && mocha\"",
    "ci-test:docker": "concurrently --kill-others \"pnpm start:docker\" \"wait-on http://localhost:8080 && mocha\"",
    "test": "mocha",
    "test:registry": "node --test scripts/prepare-registry-package.test.mjs scripts/check-registry-version.test.mjs",
    "test:server": "node --import ./deploy/server/register.mjs test/smoke/serverImports.mjs && node --import ./deploy/server/register.mjs test/smoke/workerEntry.mjs && node --import ./deploy/server/register.mjs test/smoke/serverHeaders.mjs",
    "start": "pnpm exec wrangler pages dev ./frontend-dist --kv \"img_url\" --r2 \"img_r2\" --ip 0.0.0.0 --port 8080 --persist-to ./data",
    "start:docker": "node --import ./deploy/server/register.mjs deploy/server/index.js",
    "deploy:worker": "node deploy/worker/generate-routes.js && pnpm exec wrangler deploy --config deploy/worker/wrangler.toml"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "^5.3.6"
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "miniflare": "^4.20260708.1",
    "mocha": "^8.1.3",
    "wait-on": "^7.2.0",
    "wrangler": "^4.24.0"
  }
}
